PROJECT_NAME="Vinayaka Chavithi Fund Transparency System"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200
DATABASE_URL="sqlite:///./vinayaka.db"
ADMIN_EMAIL="admin@vinayaka.org"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Committee Admin"

# Cloud / Render HTTPS Email API (Recommended for Render, works on Port 443)
# Free tier available: Sign up at https://resend.com, generate API key, paste here:
RESEND_API_KEY="re_xxxxxxxxxxxx"
# For production delivery, verify your own domain in Resend and use an address from that domain.
# The default onboarding@resend.dev test sender can only send to your Resend account email.
RESEND_FROM_EMAIL="Vinayaka Committee <donations@your-verified-domain.com>"
# Optional test-mode fallback when RESEND_FROM_EMAIL still uses onboarding@resend.dev:
RESEND_VERIFIED_TO_EMAIL="your-resend-account-email@example.com"

# Alternative: Brevo (Sendinblue) API Key (Free 300 emails/day)
# BREVO_API_KEY="xkeysib-xxxxxxxxxxxx"
SENDER_EMAIL="donations@your-verified-domain.com"

# Local Development SMTP Notification Configuration.
# Render free web services block common SMTP ports 25, 465, and 587; use Resend/Brevo HTTPS APIs there.
# Set ALLOW_RENDER_SMTP=true only on a paid Render service where SMTP egress is allowed.
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
ALLOW_RENDER_SMTP=false
SMTP_USERNAME="your-gmail-address@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"
NOTIFICATION_EMAIL="chukkasatyateja@gmail.com"
